PRODUCT_BUNDLE_IDENTIFIER = dev.fpl.canvas.tvos
PRODUCT_NAME = CanvasTV
DEVELOPMENT_TEAM = 8B3GZ9UEGE
CODE_SIGN_STYLE = Automatic
TVOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 3
SUPPORTED_PLATFORMS = appletvos appletvsimulator
SWIFT_VERSION = 5.0
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Canvas.h
INFOPLIST_FILE = $(SRCROOT)/Info-device.plist
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
OTHER_LDFLAGS = $(inherited) -lcanvas_tvos -framework UIKit -framework AVFoundation -framework Security
LIBRARY_SEARCH_PATHS = $(inherited) $(BUILT_PRODUCTS_DIR)
ENABLE_USER_SCRIPT_SANDBOXING = NO
ENABLE_BITCODE = NO
SWIFT_EMIT_LOC_STRINGS = YES
GENERATE_INFOPLIST_FILE = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
