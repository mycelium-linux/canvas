// soil:webgpu@1.0.0 — a WebGPU-shaped capability for Soil.
//
// DEFINED, not shipped. No import is linked until the app manifest requests
// `soil:webgpu`, the principal grants it, and host policy allows the
// intersection. The host owns the adapter, device, queue, and presentation
// surface; a Spore sees handles and typed descriptors, never raw GPU objects,
// driver pointers, or a swapchain.
//
// The first linked slice is deliberately a probe: it proves the WIT ->
// wasmtime -> wgpu path with an offscreen render and readback. Resource
// creation (buffers, textures, pipelines, command encoders) is the next slice;
// the shapes live in `types` so that slice does not rename anything.
//
// Limits (Soil-enforced, not expressible as WIT types):
// - one device and one queue per Spore, owned by the Soil host
// - no cross-Spore handles; every handle is a host resource-table index
// - shader bytes require a separate `soil:webgpu.shaders` authority
// - probe output is bounded (<= 16 MiB) and every call has a deadline
// - no filesystem, network, clock, environment, or JavaScript surface
package soil:webgpu@1.0.0;

interface types {
  /// Opaque, Soil-issued handles. They are not addresses or GPU ids.
  type device-handle = u32;
  type buffer-handle = u32;
  type texture-handle = u32;
  type shader-handle = u32;
  type pipeline-handle = u32;

  enum texture-format {
    rgba8-unorm,
    rgba8-unorm-srgb,
    bgra8-unorm,
    bgra8-unorm-srgb,
    depth32-float,
  }

  enum buffer-usage {
    vertex,
    index,
    uniform,
    storage,
    copy-src,
    copy-dst,
  }

  enum vertex-format {
    float32x2,
    float32x3,
    float32x4,
    uint32,
    uint32x2,
  }

  enum vertex-step {
    vertex,
    instance,
  }

  record vertex-attribute {
    format: vertex-format,
    offset: u64,
    location: u32,
  }

  record vertex-buffer-layout {
    array-stride: u64,
    step-mode: vertex-step,
    attributes: list<vertex-attribute>,
  }

  enum binding-kind {
    uniform-buffer,
    storage-buffer,
    texture,
    sampler,
  }

  record binding-layout {
    binding: u32,
    /// Bitmask: 1=vertex, 2=fragment, 4=compute.
    visibility: u32,
    kind: binding-kind,
  }

  variant binding-resource {
    buffer(u32),
    texture(u32),
    sampler(u32),
  }

  record binding-entry {
    binding: u32,
    value: binding-resource,
  }

  enum sampler-filter {
    nearest,
    linear,
  }

  enum sampler-address {
    clamp-to-edge,
    repeat,
    mirror-repeat,
  }

  enum index-format {
    uint16,
    uint32,
  }

  record buffer-desc {
    size: u64,
    usages: list<buffer-usage>,
  }

  record texture-desc {
    width: u32,
    height: u32,
    format: texture-format,
    /// Render targets are host-bound; a Spore cannot name a display.
    render-attachment: bool,
    copy-src: bool,
  }

  record color {
    r: f32,
    g: f32,
    b: f32,
    a: f32,
  }

  record adapter-info {
    name: string,
    backend: string,
    device-type: string,
  }
}

interface webgpu {
  use types.{
    adapter-info, binding-entry, binding-layout, buffer-usage, color, index-format,
    sampler-address, sampler-filter, texture-format, vertex-buffer-layout,
  };

  enum error {
    /// `soil:webgpu` (or `soil:webgpu.shaders`) is not granted.
    denied,
    /// No adapter/device is available to this host.
    not-ready,
    /// A descriptor is malformed or outside host limits.
    invalid,
    /// A per-call or per-Spore budget was exceeded.
    over-budget,
    /// The host device was lost; the Spore must recreate resources.
    device-lost,
    /// Backend failure; details are logged Soil-side, not echoed raw.
    io,
  }

  /// Adapter identity for diagnostics. Read-only; no device is created.
  adapter: func() -> result<adapter-info, error>;

  /// Allocate a host buffer and return a Soil-issued handle.
  create-buffer: func(size: u64, usages: list<buffer-usage>) -> result<u32, error>;

  /// Write bytes into a buffer at `offset`.
  write-buffer: func(buffer: u32, offset: u64, data: list<u8>) -> result<_, error>;

  /// Allocate a host texture and return a Soil-issued handle.
  create-texture: func(
    width: u32,
    height: u32,
    format: texture-format,
    render-attachment: bool,
    copy-src: bool,
  ) -> result<u32, error>;

  /// Compile WGSL into a host shader module. Requires
  /// `soil:webgpu.shaders` in addition to `soil:webgpu`.
  create-shader: func(wgsl: string) -> result<u32, error>;

  /// Build a render pipeline for one shader, colour format, vertex layouts,
  /// and bind-group layouts.
  create-pipeline: func(
    shader: u32,
    format: texture-format,
    vertex-buffers: list<vertex-buffer-layout>,
    bind-group-layouts: list<u32>,
  ) -> result<u32, error>;

  create-command-encoder: func() -> result<u32, error>;
  begin-render-pass: func(encoder: u32, texture: u32, clear: color) -> result<u32, error>;
  set-pipeline: func(pass: u32, pipeline: u32) -> result<_, error>;
  set-vertex-buffer: func(pass: u32, slot: u32, buffer: u32) -> result<_, error>;
  set-index-buffer: func(pass: u32, buffer: u32, format: index-format) -> result<_, error>;
  set-bind-group: func(pass: u32, index: u32, group: u32) -> result<_, error>;
  draw: func(pass: u32, vertex-count: u32, instances: u32) -> result<_, error>;
  draw-indexed: func(pass: u32, index-count: u32, base-vertex: u32, instances: u32) -> result<_, error>;
  end-pass: func(pass: u32) -> result<_, error>;
  submit: func(encoder: u32) -> result<u64, error>;

  create-bind-group-layout: func(entries: list<binding-layout>) -> result<u32, error>;
  create-bind-group: func(layout: u32, entries: list<binding-entry>) -> result<u32, error>;
  create-sampler: func(filter: sampler-filter, address: sampler-address) -> result<u32, error>;

  /// Draw a mesh into a texture using Soil-issued vertex/index buffers and
  /// bind groups.
  draw-mesh: func(
    texture: u32,
    pipeline: u32,
    vertex-buffer: u32,
    index-buffer: option<u32>,
    index-format: index-format,
    index-count: u32,
    instances: u32,
    bind-groups: list<u32>,
  ) -> result<_, error>;

  /// Draw a host-owned fullscreen triangle into a texture.
  draw-triangle: func(texture: u32, pipeline: u32) -> result<_, error>;

  /// Read a texture back as tightly packed RGBA8.
  read-pixels: func(texture: u32) -> result<list<u8>, error>;

  /// First-slice proof: render a fullscreen triangle through wgpu and return
  /// tightly packed RGBA8 pixels. This is a probe, not the public drawing API.
  render-probe: func(width: u32, height: u32) -> result<list<u8>, error>;
}
