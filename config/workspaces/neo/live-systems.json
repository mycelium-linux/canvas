        "schema_version": 2, "id": "clock", "kind": "clock", "format": "%H:%M:%S", "mode": "analog",
        "theme": null, "refresh_ms": 16, "chrome": "frameless",
        "data": { "state": "ready", "source": "home-pi", "observed_at": null, "window": "live", "detail": null, "provenance": "live" }
      }}, "inputs": []
    },
    {
      "id": "now-playing-art", "title": "Now playing artwork source",
      "content": { "kind": "live_image", "source_id": "now-playing-art" }, "inputs": []
    },
    {
      "id": "now-playing", "title": "Now playing",
