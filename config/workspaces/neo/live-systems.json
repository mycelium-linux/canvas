      }}, "inputs": [{ "id": "media", "contract": "canvas.widget.snapshot.v1" }]
    },
    {
      "id": "daw", "title": "Synesthesia studio",
      "content": { "kind": "widget", "spec": {
        "schema_version": 2, "id": "daw", "kind": "daw_deck", "title": "Synesthesia studio",
        "playing": false, "paused": false, "recording": false, "bpm": null,
        "position_ticks": 0, "cycle_ticks": 1,
        "tracks": [{"label":"API","level":0.0,"clipping":false}], "notes": [],
        "theme": null, "refresh_ms": 250, "chrome": "integrated",
        "data": { "state": "loading", "source": "synesthesia/daw", "observed_at": null, "window": "live", "detail": "Awaiting studio telemetry", "provenance": "live" }
      }}, "inputs": [{ "id": "daw", "contract": "canvas.widget.snapshot.v1" }]
    },
    {
      "id": "mesh", "title": "Mycelium mesh",
      "content": { "kind": "widget", "spec": {
        "schema_version": 2, "id": "mesh", "kind": "neural_graph", "title": "Mycelium web",
        "nodes": [], "edges": [],
        "theme": null, "refresh_ms": 5000, "chrome": "integrated",
        "data": { "state": "loading", "source": "mycelium/mesh", "observed_at": null, "window": "live", "detail": "Awaiting peer snapshot", "provenance": "live" }
      }}, "inputs": [{ "id": "mesh", "contract": "canvas.widget.snapshot.v1" }]
    },
    {
      "id": "systems", "title": "Systems",
      "content": { "kind": "widget", "spec": {
        "schema_version": 2, "id": "systems", "kind": "status_list", "title": "home-pi · live systems", "nodes": [],
        "theme": null, "refresh_ms": 5000, "chrome": "integrated",
        "data": { "state": "loading", "source": "systemd", "observed_at": null, "window": "live", "detail": "Awaiting first observation", "provenance": "live" }
      }}, "inputs": [{ "id": "services", "contract": "canvas.widget.snapshot.v1" }]
