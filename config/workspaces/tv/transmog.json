{
  "schema_version": 1,
  "id": "transmog-workspace",
  "project_id": "transmog",
  "revision": 7,
  "theme": { "source": "project" },
  "background": { "kind": "shader", "shader_id": "smoke-rings", "speed": 0.22 },
  "chrome": { "title": "hidden", "canvas_padding": 6, "surface_gap": 6 },
  "surfaces": [
    {
      "id": "transmog-files",
      "title": "Project",
      "content": { "kind": "widget", "spec": {
        "schema_version": 2, "id": "transmog-files", "kind": "table",
        "title": "Project files", "columns": ["Name", "Kind", "Folder", "Size"], "rows": [],
        "theme": null, "refresh_ms": null, "chrome": "integrated",
        "data": { "state": "loading", "source": "alfalfa:transmog", "observed_at": null,
          "window": "current revision", "detail": "Loading project manifest", "provenance": "live" }
      } },
      "inputs": [{ "id": "results", "contract": "canvas.widget.snapshot.v1" }]
    },
    {
      "id": "transmog-part", "title": "Model",
      "content": { "kind": "live_video", "source_id": "transmog-step", "width": 1280, "height": 720,
        "orbitable": true, "timeline": true },
      "inputs": [{ "id": "timeline", "contract": "transmog.build.status.v1" }]
    },
    {
      "id": "transmog-run", "title": "Run",
      "content": { "kind": "widget", "spec": {
        "schema_version": 2, "id": "transmog-run", "kind": "status_list", "title": "Waiting for a run",
        "nodes": [], "theme": null, "refresh_ms": 250, "chrome": "integrated",
        "data": { "state": "loading", "source": "eval.watch.v1", "observed_at": null,
          "window": "live", "detail": "RLCD execution summary", "provenance": "live" }
      } },
      "inputs": [{ "id": "run", "contract": "canvas.run.watch.v1" }]
    },
    {
      "id": "transmog-decisions", "title": "Decisions",
      "content": { "kind": "widget", "spec": {
        "schema_version": 2, "id": "transmog-decisions", "kind": "dag_graph", "title": "Waiting for decisions",
        "nodes": [], "edges": [], "theme": null, "refresh_ms": 250, "chrome": "integrated",
        "data": { "state": "loading", "source": "eval.watch.v1", "observed_at": null,
          "window": "live", "detail": "RLCD decision trace", "provenance": "live" }
      } },
      "inputs": [{ "id": "run", "contract": "canvas.run.watch.v1" }]
    },
    {
      "id": "transmog-checks", "title": "Checks",
      "content": { "kind": "widget", "spec": {
        "schema_version": 2, "id": "transmog-checks", "kind": "status_list", "title": "Waiting for verification",
        "nodes": [], "theme": null, "refresh_ms": 250, "chrome": "integrated",
        "data": { "state": "loading", "source": "eval.watch.v1", "observed_at": null,
          "window": "live", "detail": "RLCD verdicts", "provenance": "live" }
      } },
      "inputs": [{ "id": "run", "contract": "canvas.run.watch.v1" }]
    },
    {
      "id": "transmog-events", "title": "Build and evaluation",
      "content": { "kind": "widget", "spec": {
        "schema_version": 2, "id": "transmog-events", "kind": "event_log", "title": "Run timeline",
        "entries": [], "follow": true, "theme": null, "refresh_ms": 250, "chrome": "integrated",
        "data": { "state": "loading", "source": "eval.watch.v1", "observed_at": null,
          "window": "live", "detail": "Build, assembly, and evaluation events", "provenance": "live" }
      } },
      "inputs": [{ "id": "run", "contract": "canvas.run.watch.v1" }]
    },
    {
      "id": "transmog-ask", "title": "New or revise",
      "content": { "kind": "prompt", "target": "transmog",
        "placeholder": "Describe a new part or a change to the selected model…",
        "task_kinds": ["PCB", "Model"], "task_targets": { "PCB": "lob", "Model": "transmog" } },
      "inputs": []
    }
  ],
  "layout": { "kind": "canvas", "placements": [
    { "surface_id": "transmog-files", "bounds": { "x": 0.000, "y": 0.000, "width": 0.220, "height": 1.000 }, "layer": 0 },
    { "surface_id": "transmog-part", "bounds": { "x": 0.220, "y": 0.000, "width": 0.570, "height": 0.760 }, "layer": 0 },
    { "surface_id": "transmog-run", "bounds": { "x": 0.790, "y": 0.000, "width": 0.210, "height": 0.300 }, "layer": 0 },
    { "surface_id": "transmog-decisions", "bounds": { "x": 0.790, "y": 0.300, "width": 0.210, "height": 0.406 }, "layer": 0 },
    { "surface_id": "transmog-checks", "bounds": { "x": 0.790, "y": 0.706, "width": 0.210, "height": 0.294 }, "layer": 0 },
    { "surface_id": "transmog-events", "bounds": { "x": 0.220, "y": 0.760, "width": 0.410, "height": 0.240 }, "layer": 0 },
    { "surface_id": "transmog-ask", "bounds": { "x": 0.630, "y": 0.760, "width": 0.160, "height": 0.240 }, "layer": 0 }
  ] },
  "pages": [],
  "active_page": 0,
  "bindings": [
    {
