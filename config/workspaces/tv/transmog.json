      "target": { "surface_id": "transmog-part", "input_id": "timeline" },
      "adapter": "transmog-build-v1", "delivery": { "mode": "latest" }
    },
    {
      "id": "transmog-files-live",
      "source": { "owner": "canvas-artifact-index", "stream": "transmog-artifacts", "contract": "canvas.artifact.search.v1" },
      "target": { "surface_id": "transmog-files", "input_id": "results" },
      "adapter": "alfalfa-manifest-search-v1", "delivery": { "mode": "latest" }
    },
    {
      "id": "transmog-run-live",
