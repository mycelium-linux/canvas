      "target": { "surface_id": "transmog-run", "input_id": "run" },
      "adapter": "eval-watch-v1", "delivery": { "mode": "latest" }
    },
    {
      "id": "transmog-decisions-live",
      "source": { "owner": "eval-studio", "stream": "eval-decisions", "contract": "canvas.run.watch.v1" },
      "target": { "surface_id": "transmog-decisions", "input_id": "run" },
      "adapter": "eval-watch-v1", "delivery": { "mode": "latest" }
    },
    {
      "id": "transmog-checks-live",
      "source": { "owner": "eval-studio", "stream": "eval-verification", "contract": "canvas.run.watch.v1" },
      "target": { "surface_id": "transmog-checks", "input_id": "run" },
      "adapter": "eval-watch-v1", "delivery": { "mode": "latest" }
    },
    {
      "id": "transmog-events-live",
