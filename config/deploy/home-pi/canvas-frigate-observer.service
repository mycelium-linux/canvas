[Unit]
Description=Publish Frigate detections over Unibus
After=network-online.target unibus-router.service canvas-media-edge.service
Wants=network-online.target
Requires=unibus-router.service canvas-media-edge.service

[Service]
Type=simple
User=ajm
Environment=HOME=/home/ajm
ExecStart=/usr/local/bin/canvas-frigate-observer /home/ajm/.config/canvas/frigate-observer.json
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
