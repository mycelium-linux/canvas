[Unit]
Description=Announce the Panopticon globe stream to Canvas
After=network-online.target unibus-router.service canvas-media-edge.service
Wants=network-online.target
Requires=unibus-router.service canvas-media-edge.service

[Service]
Type=simple
User=ajm
Environment=HOME=/home/ajm
ExecStart=/usr/local/bin/canvas-media-announce /home/ajm/.config/canvas/media-panopticon-globe.json
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
