[Unit]
Description=Fan out Canvas media lane %i
After=network-online.target
Wants=network-online.target
Before=canvas-media-edge.service

[Service]
Type=simple
User=ajm
EnvironmentFile=/etc/canvas/media-fanout-%i.conf
ExecStart=/usr/bin/gst-launch-1.0 -q tcpserversrc host=127.0.0.1 port=${INPUT_PORT} ! queue max-size-buffers=0 max-size-bytes=0 max-size-time=2000000000 leaky=downstream ! tcpserversink host=127.0.0.1 port=${OUTPUT_PORT} sync=false
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
