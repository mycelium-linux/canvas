<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.fpl.canvas-agent-bridge</string>
  <!-- Canvas guards itself with flock(2) on runtime.lock, so a second copy
       refuses to start. That guard is defeated by deleting the lock file:
       the running process keeps its flock on the unlinked inode while the
       newcomer creates a fresh one, and both then fight over the same
       displays. Supervising it here is what keeps the count at one. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ajmwagar/.local/bin/canvas-agent-bridge</string>
    <!-- Keep runtime configuration outside Documents. Background launchd
         services can otherwise stall in open(2) while macOS evaluates the
         protected Documents-folder access policy. -->
    <string>/Users/ajmwagar/.config/canvas/agent-bridge.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- Long enough that a crash-loop is visible in the log rather than a
       wall of restarts, short enough that a real crash comes back fast. -->
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/ajmwagar/Library/Logs/canvas-agent-bridge.log</string>
  <key>StandardErrorPath</key><string>/Users/ajmwagar/Library/Logs/canvas-agent-bridge.log</string>
</dict>
</plist>
