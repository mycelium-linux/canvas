<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.fpl.canvas-model-benchy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ajmwagar/.local/bin/canvas-model-host</string>
    <string>/Users/ajmwagar/.config/dock/canvas/model-scenes/benchy.lua</string>
    <string>/Users/ajmwagar/.cache/dock/canvas/model-assets</string>
    <!-- Direct fanout keeps the model alive without requiring a TCP listener
         to connect first, and gives every screen the same low-latency path. -->
    <string>udp://127.0.0.1:55206,udp://100.120.101.5:55206,udp://192.168.20.13:55206</string>
    <string>320</string>
    <string>180</string>
    <string>24</string>
    <string>videotoolbox</string>
    <string>model-benchy</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Same reason as the transmog painter: without this launchd runs the job
       at background QoS on the efficiency cores, at roughly a third of the
       frame rate the same binary reaches from a shell. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/ajmwagar/Library/Logs/canvas-model-benchy.log</string>
  <key>StandardErrorPath</key><string>/Users/ajmwagar/Library/Logs/canvas-model-benchy.log</string>
</dict>
</plist>
