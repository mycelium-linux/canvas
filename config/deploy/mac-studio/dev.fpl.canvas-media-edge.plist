<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.fpl.canvas-media-edge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ajmwagar/.local/bin/canvas-media-edge</string>
    <string>/Users/ajmwagar/.config/canvas/media-edge.json</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- gst-launch resolves its plugin scanner and typelibs through the
         Homebrew prefix, which a launchd job does not inherit. -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/ajmwagar/Library/Logs/canvas-media-edge.log</string>
  <key>StandardErrorPath</key><string>/Users/ajmwagar/Library/Logs/canvas-media-edge.log</string>
</dict>
</plist>
