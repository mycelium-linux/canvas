[Unit]
Description=Canvas Bluesky war-room feed
After=network-online.target canvas-surface.service
Wants=network-online.target

[Service]
Type=simple
User=ajm
Environment=HOME=/home/ajm
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/local/bin/canvas-bsky-trends --config /etc/canvas/bsky-trends.json
EnvironmentFile=-/etc/canvas/bsky-trends.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=default.target
