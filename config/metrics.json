{
  "schema_version": 1,
  "poll_seconds": 30,
  "sources": {
    "fleet/backends": {
      "kind": "stat",
      "query": "sum(bifrost_backend_up)",
      "label": "Backends up",
      "warn_below": 12,
      "critical_below": 1
    },
    "fleet/gpu-util": {
      "kind": "gauge",
      "query": "max(yggdrasil_accelerator_utilization_pct)",
      "label": "GPU utilization"
    },
    "fleet/gpu-power": {
      "kind": "stat",
      "query": "sum(yggdrasil_accelerator_power_watts)",
      "label": "Accelerator draw",
      "unit": "W",
      "warn_above": 400,
      "critical_above": 600
    },
    "fleet/vram": {
      "kind": "gauge",
      "query": "100 * sum(yggdrasil_accelerator_memory_used_bytes) / sum(yggdrasil_accelerator_memory_bytes)",
      "label": "VRAM used"
    },
    "fleet/inflight": {
      "kind": "time_series",
      "query": "sum by (node) (bifrost_yggdrasil_runtime_inflight_requests)",
      "window_seconds": 1800,
      "step_seconds": 30,
      "label": "In-flight requests by node",
      "series_labels": [
        "node"
      ]
    },
    "fleet/latency": {
      "kind": "ranked_bar",
      "query": "bifrost_yggdrasil_runtime_latency_ms",
      "label": "Runtime latency",
      "unit": "ms",
      "series_labels": [
        "runtime"
      ]
    },
    "fleet/sessions": {
      "kind": "stat",
      "query": "fpl_auth_active_sessions",
      "label": "Active SSO sessions"
    },
    "fleet/gateway": {
      "kind": "time_series",
      "query": "palisade_active_connections",
      "window_seconds": 1800,
      "step_seconds": 30,
      "label": "Gateway connections",
      "series_labels": [
        "instance"
      ]
    },
    "bifrost/health": {
      "kind": "stat",
      "query": "sum(bifrost_backend_up)",
      "label": "Backends up",
      "warn_below": 12,
      "critical_below": 1
    },
    "bifrost/queue": {
      "kind": "time_series",
      "query": "sum by (node) (bifrost_yggdrasil_runtime_inflight_requests)",
      "window_seconds": 1800,
      "step_seconds": 30,
      "label": "Queue depth by node",
      "series_labels": [
        "node"
      ]
    },
    "bifrost/latency": {
      "kind": "heatmap",
      "query": "bifrost_yggdrasil_runtime_latency_ms",
      "window_seconds": 900,
      "step_seconds": 30,
      "label": "Runtime latency",
      "unit": "ms",
      "series_labels": [
        "runtime"
      ]
    },
    "bifrost/cache": {
      "kind": "gauge",
      "query": "",
      "label": "Prefix cache hit ratio",
      "unavailable": "Bifrost exposes no cache metric"
    },
    "bifrost/tokens": {
      "kind": "stat",
      "query": "",
      "label": "Tokens",
      "unavailable": "Bifrost exposes no token counter"
    },
    "bifrost/fallbacks": {
      "kind": "event_log",
      "query": "",
      "label": "Fallbacks",
      "unavailable": "Bifrost exposes no fallback events"
    },
    "bifrost/cost": {
      "kind": "stat",
      "query": "",
      "label": "Cost",
      "unavailable": "Bifrost exposes a provider price list, not spend"
    },
    "bifrost/slo": {
      "kind": "slo_burn_rate",
      "query": "",
      "label": "Error budget",
      "unavailable": "No SLO or error-budget metric is recorded"
    },
    "elmers/loop": {
      "kind": "stat",
      "query": "",
      "label": "Loop health",
      "unavailable": "No elmers job is scraped by Prometheus"
    },
    "elmers/runs": {
      "kind": "stat",
      "query": "",
      "label": "In flight",
      "unavailable": "No elmers job is scraped by Prometheus"
    },
    "elmers/budget": {
      "kind": "gauge",
      "query": "",
      "label": "Budget",
      "unavailable": "No elmers job is scraped by Prometheus"
    },
    "elmers/models": {
      "kind": "ranked_bar",
      "query": "",
      "label": "Model usage",
      "unavailable": "No elmers job is scraped by Prometheus"
    },
    "elmers/workflows": {
      "kind": "time_series",
      "query": "",
      "label": "Workflow rate",
      "unavailable": "No elmers job is scraped by Prometheus"
    }
  }
}
