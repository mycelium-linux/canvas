#!/usr/bin/env python3
"""canvas-stream: protocol gateway between event sources and Canvas.

Forwards events from stdin/HTTP/WebSocket to Canvas's stream.sock (UDP DGRAM).
Also mirrors events to connected SSE clients. Config is hot-reloaded.
"""
import argparse, json, os, socket, sys, time, threading
from pathlib import Path
from http.server import HTTPServer, BaseHTTPRequestHandler
from socketserver import ThreadingMixIn

CONTRACT_V1 = "canvas.stream.event.v1"
MAX_DATAGRAM = 64 * 1024
DEFAULT_SOCKET = os.path.join(
    os.environ.get("HOME", ""), "Library/Application Support/Dock/canvas/stream.sock"
)

class StreamRouter:
    def __init__(self, config_path, socket_path, debug=False):
        self.config_path = Path(config_path)
        self.socket_path = socket_path
        self.debug = debug
        self.routes = []
        self.sse_clients = []
        self.sse_lock = threading.Lock()
        self.load_config()
        self.config_mtime = self.config_path.stat().st_mtime if self.config_path.exists() else 0
        self.udp_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)

    def load_config(self):
        if self.config_path.exists():
            try:
                with open(self.config_path) as f:
                    if self.config_path.suffix in (".json",):
                        import tomllib if sys.version_info >= (3, 11) else None
                        if sys.version_info >= (3, 11):
                            with open(self.config_path, "rb") as bf:
                                data = tomllib.load(bf)
                        else:
                            # Simple fallback: treat as JSON
                            data = json.loads(f.read())
                    else:
                        data = json.loads(f.read())
                self.routes = data.get("routes", [])
            except Exception:
                self.routes = []
        if not self.routes:
            self.routes = [{"source": "*", "contract": "*", "dest": ["stream.sock"]}]

    def check_reload(self):
        if self.config_path.exists():
            mtime = self.config_path.stat().st_mtime
            if mtime != self.config_mtime:
                self.config_mtime = mtime
                self.load_config()
                if self.debug:
                    print(f"config reloaded: {len(self.routes)} routes", file=sys.stderr)

    def route(self, event):
        self.check_reload()
        source = event.get("source", "")
        contract = event.get("contract", "")
        for route in self.routes:
            if (route["source"] in ("*", source) and
                route["contract"] in ("*", contract)):
                return route.get("dest", ["stream.sock"])
        return ["stream.sock"]

    def forward(self, event):
        dests = self.route(event)
        payload = json.dumps(event, separators=(",", ":")).encode()
        if len(payload) > MAX_DATAGRAM:
            payload = payload[:MAX_DATAGRAM]
        for dest in dests:
            if dest == "stream.sock":
                try:
                    self.udp_sock.sendto(payload, self.socket_path)
                except Exception:
                    pass
            elif dest == "sse":
                with self.sse_lock:
                    dead = []
                    for q in self.sse_clients:
                        try:
                            q.put(payload)
                        except Exception:
                            dead.append(q)
                    for q in dead:
                        self.sse_clients.remove(q)
        if self.debug:
            print(f"→ {event.get('source')}:{event.get('contract')} dest={dests}", file=sys.stderr)

router = None

class SSEHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/stream':
            import queue
            q = queue.Queue()
            with router.sse_lock:
                router.sse_clients.append(q)
            self.send_response(200)
            self.send_header('Content-Type', 'text/event-stream')
            self.send_header('Cache-Control', 'no-cache')
            self.send_header('Connection', 'keep-alive')
            self.end_headers()
            try:
                while True:
                    try:
                        data = q.get(timeout=30)
                        self.wfile.write(f"data: {data.decode()}\n\n".encode())
                        self.wfile.flush()
                    except queue.Empty:
                        break
            except Exception:
                pass
            finally:
                with router.sse_lock:
                    if q in router.sse_clients:
                        router.sse_clients.remove(q)
        elif self.path == '/healthz':
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"ok")
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass

class SSEServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--socket", default=DEFAULT_SOCKET)
    ap.add_argument("--config", default="config/stream-router.json")
    ap.add_argument("--http", type=int, default=0, help="HTTP port (0 = disabled)")
    ap.add_argument("--debug", action="store_true")
    args = ap.parse_args()

    global router
    router = StreamRouter(args.config, args.socket, args.debug)

    # Start HTTP/SSE server if requested
    if args.http:
        server = SSEServer(("127.0.0.1", args.http), SSEHandler)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        print(f"canvas-stream: SSE on http://127.0.0.1:{args.http}/stream", file=sys.stderr)

    # Read events from stdin
    print(f"canvas-stream: forwarding to {args.socket}", file=sys.stderr)
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            if line.startswith("{"):
                event = json.loads(line)
                router.forward(event)
        except json.JSONDecodeError:
            pass

if __name__ == "__main__":
    main()
