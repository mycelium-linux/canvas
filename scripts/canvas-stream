#!/usr/bin/env python3
"""canvas-stream: protocol gateway between event sources and Canvas.

Accepts events over HTTP (POST), WebSocket, stdin, and file-watch, then
forwards them as UDP datagrams to Canvas's stream.sock. Also mirrors events
back over SSE for cloud agents monitoring the wall.

Config: config/stream-router.toml (hot-reloaded on change).
Lua binder influence: Lua binders return routing hints in their output,
which Canvas writes to the config via control command. The sidecar watches
the config file and applies changes without restart.

Usage:
  canvas-stream                    # read events from stdin → stream.sock
  canvas-stream --http PORT        # also listen on HTTP PORT
  canvas-stream --config FILE      # custom config (default: config/stream-router.toml)
  canvas-stream --sse PORT         # also serve SSE on PORT
"""
import argparse, asyncio, json, os, socket, sys, time, hashlib
from pathlib import Path

CONTRACT_V1 = "canvas.stream.event.v1"
MAX_DATAGRAM = 64 * 1024

class StreamRouter:
    def __init__(self, config_path, socket_path, debug=False):
        self.config_path = Path(config_path)
        self.socket_path = socket_path
        self.debug = debug
        self.routes = []  # list of (source, contract, destinations)
        self.subscribers = []  # SSE/WebSocket clients
        self.load_config()
        self.last_config_mtime = self.config_path.stat().st_mtime if self.config_path.exists() else 0
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.udp_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)

    def load_config(self):
        """Load routing config. Lua binders influence routing through Canvas
        writing route updates to this config file."""
        if self.config_path.exists():
            import tomllib if sys.version_info >= (3, 11) else None
            try:
                if sys.version_info >= (3, 11):
                    with open(self.config_path, "rb") as f:
                        import tomllib; data = tomllib.load(f)
                else:
                    # Fallback: simple JSON or TOML parsing
                    with open(self.config_path) as f:
                        data = json.load(f)
                self.routes = data.get("routes", [])
            except Exception:
                self.routes = []
        # Default: route everything to stream.sock
        if not self.routes:
            self.routes = [{"source": "*", "contract": "*", "dest": ["stream.sock"]}]

    def reload_if_changed(self):
        if not self.config_path.exists():
            return
        mtime = self.config_path.stat().st_mtime
        if mtime != self.last_config_mtime:
            self.last_config_mtime = mtime
            self.load_config()
            if self.debug:
                print(f"config reloaded: {len(self.routes)} routes", file=sys.stderr)

    def should_route(self, event):
        """Check if an event matches any routing rule.
        Lua binders influence this via the config file — they can
        register routes through Canvas control commands that update
        config/stream-router.toml."""
        self.reload_if_changed()
        source = event.get("source", "")
        contract = event.get("contract", "")
        for route in self.routes:
            if (route["source"] in ("*", source) and
                route["contract"] in ("*", contract)):
                return route.get("dest", ["stream.sock"])
        return ["stream.sock"]

    def send_to_canvas(self, event):
        """Forward event as UDP datagram to Canvas stream.sock."""
        dests = self.should_route(event)
        payload = json.dumps(event, separators=(",", ":")).encode()
        if len(payload) > MAX_DATAGRAM:
            payload = payload[:MAX_DATAGRAM]
        for dest in dests:
            if dest == "stream.sock":
                try:
                    self.udp_sock.sendto(payload, self.socket_path)
                except Exception:
                    pass
            elif dest == "sse":
                for tx in self.subscribers:
                    try:
                        tx.send(event)
                    except:
                        pass
        if self.debug:
            print(f"→ {event.get('source')}:{event.get('contract')} routes={dests}", file=sys.stderr)

async def handle_http_post(State(state): AppState, Json(event): Json<serde_json::Value>) -> impl IntoResponse {
    # Normalize to StreamEvent
    se = StreamEvent {
        schema_version: event.get("schema_version", 1).as_u64().unwrap_or(1) as u32,
        source: event.get("source", "http").as_str().unwrap_or("http").to_string(),
        stream: event.get("stream", "http").as_str().unwrap_or("http").to_string(),
        contract: event.get("contract", CONTRACT_V1).as_str().unwrap_or(CONTRACT_V1).to_string(),
        sequence: event.get("sequence", 0).as_u64().unwrap_or(0),
        emitted_at_ms: event.get("emitted_at_ms", int(time.time()*1000)).as_u64().unwrap_or(0) as u64,
        payload: event,
    }
    state.send_to_canvas(&se)
    "ok"
}

async fn sse_handler(State(state)) -> Sse<impl Stream<Item = Result<sse::Event, axum::Error>>> {
    let mut rx = state.broadcast.subscribe();
    let stream = async_stream::stream! {
        while let Ok(event) = rx.recv().await {
            let data = serde_json::to_string(&event).unwrap();
            yield Ok(sse::Event::Data(sse::Data::new(data)));
        }
    };
    sse::keep_alive().stream(stream)
}

#[tokio::main]
async fn main() {
    ...
}
